# ── Credenciales de APIs ──────────────────────────────────────
# Token de tu bot de Telegram (obtenido desde @BotFather)
BOT_TOKEN=tu_token_de_telegram_aqui

# Tu API Key de OpenAI (para la extracción de datos con GPT-4o)
OPENAI_API_KEY=sk-tu_api_key_de_openai_aqui
OPENAI_MODEL=gpt-4o

# (Opcional) IDs de Telegram autorizados a usar el bot, separados por comas.
# Si lo dejas vacío, cualquier usuario podrá interactuar con el bot.
AUTHORIZED_USERS=123456789,987654321

# ── Base de Datos (PostgreSQL) ────────────────────────────────
# Credenciales para la base de datos
POSTGRES_DB=facturas_erp
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=tu_contraseña_segura_aqui

# Si ejecutas el bot con Docker (docker-compose), el host debe ser "db"
# Si ejecutas el bot localmente con Python (fuera de Docker), usa "localhost"
POSTGRES_HOST=db
POSTGRES_PORT=5432
