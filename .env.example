# --- Telegram Bot ---
BOT_TOKEN=tu_token_de_telegram_aqui
MASTER_ADMIN_ID=tu_id_de_usuario_admin
AUTHORIZED_USERS=id1,id2,id3

# --- OpenAI API ---
OPENAI_API_KEY=tu_clave_de_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# --- Google Cloud (Para pruebas locales) ---
GCP_PROJECT_ID=tu-proyecto-gcp
GCS_BUCKET_NAME=tu-bucket-name
# Esta ruta apunta al archivo de llave JSON que debes poner en la raíz para el test local
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json

